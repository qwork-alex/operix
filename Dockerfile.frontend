FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

# Force invalidation layer for source when DUMMY build-arg changes
# (fix for buildkit silently caching COPY . . even with --no-cache)
ARG DUMMY
RUN echo "invalidate=$DUMMY" > /tmp/_build_invalidate && cat /tmp/_build_invalidate

COPY . .

ARG VITE_API_URL=http://localhost:4000/api
ARG VITE_PAYMENTS_CLIENT_TOKEN=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_PAYMENTS_CLIENT_TOKEN=$VITE_PAYMENTS_CLIENT_TOKEN

RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
